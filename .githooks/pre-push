#!/bin/sh
zero=0000000000000000000000000000000000000000
rust='\.rs$|(^|/)Cargo\.(toml|lock)$'
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        files=$(git log --name-only --format= "$local_sha" --not --remotes)
    else
        files=$(git diff --name-only "$remote_sha" "$local_sha")
    fi
    if printf '%s\n' "$files" | grep -qE "$rust"; then
        exec "$(git rev-parse --show-toplevel)/.githooks/checks.sh"
    fi
done
exit 0
